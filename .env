# ============================================
# MongoDB Configuration (Injection & Retrieval)
# ============================================
MONGODB_URI=

# Question Papers Collection (for similar questions & paper generation)
MONGODB_QUESTIONPAPERS_DB=
MONGODB_QUESTIONPAPERS_COLLECTION=

# Books/Textbook Collection (for concept explanation & hybrid search)
MONGODB_BOOKS_DB=
MONGODB_BOOKS_COLLECTION=

# Legacy (for backward compatibility)
MONGODB_DB_NAME=
MONGODB_COLLECTION_NAME=

# ============================================
# Mistral API (Embeddings for Injection)
# ============================================
MISTRAL_API_KEY=
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_EMBEDDING_DIM=1024

# ============================================
# Groq API (LLM for Retrieval)
# ============================================
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# ============================================
# API Configuration (Injection & Retrieval)
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# Injection Service Configuration
# ============================================
BATCH_SIZE=32
FAILED_RECORDS_PATH=data/failed_records.json
EMBEDDING_TIMEOUT=30
MAX_EMBEDDING_RETRIES=3
RETRY_BACKOFF_FACTOR=2.0
MAX_CONTENT_LENGTH=50000

# ============================================
# Retrieval Service Configuration
# ============================================
MONGODB_DB=
HYBRID_SEARCH_TOP_K=10
VECTOR_WEIGHT=0.5
BM25_WEIGHT=0.5
RRF_K=60
API_TIMEOUT_SECONDS=30
MAX_TOKENS_PER_REQUEST=2000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/ingestion.log

# ============================================
# Feature Flags
# ============================================
ENABLE_METRICS=true
ENABLE_CACHING=false
