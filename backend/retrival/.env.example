# MongoDB Atlas
MONGODB_URI=
MONGODB_DB_TEXTBOOK=10_books
MONGODB_COLLECTION_TEXTBOOK=english
MONGODB_DB_QUESTIONPAPERS=10_questionpapers
MONGODB_COLLECTION_QUESTIONPAPERS=2025_public

# Groq API
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Mistral Embeddings (REQUIRED for semantic search)
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
MISTRAL_EMBED_MODEL=mistral-embed
MISTRAL_EMBED_DIMENSION=1024

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=development

# Hybrid Search Config
HYBRID_SEARCH_RRF_K=60
HYBRID_SEARCH_DEFAULT_VECTOR_WEIGHT=0.5
HYBRID_SEARCH_DEFAULT_BM25_WEIGHT=0.5
HYBRID_SEARCH_TOP_K=5

# Logging
LOG_LEVEL=INFO
